# =====================================================================
# Modele de configuration du backend GPI
#
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
# Le fichier .env ne doit JAMAIS etre versionne (voir .gitignore racine).
# =====================================================================

# Cle secrete Django : generer une valeur unique par environnement.
# Exemple : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-cette-valeur

# Mettre False en production.
DEBUG=True

# Hotes autorises, separes par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisees pour le frontend, separees par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Rate limiting (voir REST_FRAMEWORK dans settings.py) :
# login = 5/min par IP, ticket_create = 10/heure par IP.

# Fichiers media (plans) :
# En developpement (DEBUG=True), Django les sert sous MEDIA_URL.
# En production, exposer MEDIA_ROOT via le reverse proxy.

# Base de donnees PostgreSQL
DB_NAME=gpi
DB_USER=gpi
DB_PASSWORD=changez-cette-valeur
DB_HOST=localhost
DB_PORT=5432
