@startuml
title Consultation - Point de vue Administrateur

start

:Connexion;

if (Authentification réussie ?) then (Oui)

    :Afficher le tableau de bord d'administration;

    switch (Choisir une action)

        case (Ajouter)
            :Ajouter un ordinateur;
            :Mettre à jour la base de données;

        case (Modifier)
            :Modifier un ordinateur;
            :Mettre à jour la base de données;

        case (Supprimer)
            :Supprimer un ordinateur;
            :Mettre à jour la base de données;

        case (Consulter)
            :Afficher les informations d'un ordinateur;

            if (Changer la disposition des ordinateurs ?) then (Oui)
                :Afficher la nouvelle disposition;
                :Modifier les coordonnées dans la base;
                :Sauvegarder la base;
            else (Non)
                :Conserver la disposition actuelle;
            endif

    endswitch

else (Non)

    :Afficher un message d'erreur;

endif

: Deconnexion;

stop

@enduml